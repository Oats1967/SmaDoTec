        MENUITEM "Istwert [kg/h]",              ID_MN_DIAGRAMSELECT_MASSFLOW
        MENUITEM "Sollwert [kg/h]",             ID_MN_DIAGRAMSELECT_SETPOINT
        MENUITEM "Stellbefehl [%]",             ID_MN_DIAGRAMSELECT_DRIVECOMMAND
        MENUITEM "Gewicht [kg]",                ID_MN_DIAGRAMSELECT_WEIGHT
        MENUITEM "Dosierperformanz [kg/h]",     ID_MN_DIAGRAMSELECT_DOSEPERFORMANCE
        MENUITEM "Totalisator [kg]",            ID_MN_DIAGRAMSELECT_TOTALIZER
    END
END

