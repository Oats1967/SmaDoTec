	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="Debug"
			IntermediateDirectory="Debug"
			ConfigurationType="2"
			CharacterSet="0">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				OptimizeForProcessor="2"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_USRDLL;EASYCONTROL_ITA_EXPORTS; AFX_RESOURCE_DLL"
